# Backend configuration. Copy to .env and adjust:  cp .env.example .env
#
# Loaded by small_backend/settings.py via python-dotenv. Real environment
# variables take precedence, so in production (Render, systemd, docker) set
# them there and leave this file out entirely.

# --- Security -------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# True enables Django debug pages. Keep it True locally: when DEBUG is False
# the app forces HTTPS (SSL redirect + HSTS), which breaks plain-http dev.
DEBUG=True

# --- Hosts & CORS ---------------------------------------------------------
# Add this machine's LAN address here when running the Expo mobile app on a
# phone (e.g. 192.168.1.50) — Django answers 400 for any host not listed.
ALLOWED_HOSTS=localhost,127.0.0.1

# Must include the origin the frontend is served from (Vite dev = port 3000).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dev escape hatch; leave False unless you know you need it.
CORS_ALLOW_ALL_ORIGINS=False

# --- Database -------------------------------------------------------------
# Any dj-database-url URL. Unset = local SQLite at db.sqlite3.
# DATABASE_URL=postgres://user:pass@localhost:5432/small_backend_db

# --- Links ----------------------------------------------------------------
# Absolute base URL of the frontend, used to build shareable feedback links.
# Blank means the frontend falls back to its own origin.
FRONTEND_BASE_URL=

# --- Email ----------------------------------------------------------------
# Password-reset links are emailed. The console backend prints the whole message
# to the runserver terminal, which is all local dev needs — request a reset, then
# copy the link out of the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@small.local

# For real delivery, swap the two lines above for these. With Gmail,
# EMAIL_HOST_PASSWORD is an *app password* (16 chars, 2-Step Verification must be
# on) from https://myaccount.google.com/apppasswords — never the account password.
# Gmail rewrites From to the authenticated account, so keep DEFAULT_FROM_EMAIL
# equal to EMAIL_HOST_USER.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=you@gmail.com

# How long a reset link stays valid, in seconds. Default 3 days.
PASSWORD_RESET_TIMEOUT=259200
